<div class="about-hero">
  <div class="about-hero__inner">
    <div class="about-hero__top">
      {% if section.settings.label != blank %}
        <span class="about-hero__eyebrow">
          {{ section.settings.label }}
        </span>
      {% endif %}
      {% if section.settings.number != blank %}
        <span class="about-hero__number">
          {{ section.settings.number }}
        </span>
      {% endif %}
    </div>

    <div class="about-hero__title-wrap">
      {% if section.settings.title_line_1 != blank %}
        <h1 class="about-hero__title">
          {{ section.settings.title_line_1 }}
          <br>
          <span>{{ section.settings.title_line_2 }}</span>
        </h1>
      {% endif %}

      <div class="about-hero__intro">
        {% if section.settings.intro != blank %}
          <p>{{ section.settings.intro }}</p>
        {% endif %}
      </div>
    </div>

    <div class="about-hero__visual">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 2000
          | image_tag: loading: 'eager', widths: '600, 900, 1200, 1600, 2000', class: 'about-hero__image'
        }}
      {% else %}
        <div class="about-hero__placeholder">
          <span>ESC-ALA</span>
        </div>
      {% endif %}

      <div class="about-hero__label">
        {% if section.settings.hero_label_1 != blank %}
          <span>{{ section.settings.hero_label_1 }}</span>
          <span>{{ section.settings.hero_label_2 }}</span>
          <span>{{ section.settings.hero_label_3 }}</span>
        {% endif %}
      </div>
    </div>

    <div class="about-hero__bottom">
      {% if section.settings.scroll_indicator != blank %}
        <span>{{ section.settings.scroll_indicator }}</span>
        <span class="about-hero__arrow"> ↓ </span>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .about-hero {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: #0b0f2b;
    color: #ffffff;
  }

  .about-hero__inner {
    width: min(1400px, calc(100% - 48px));
    margin: 0 auto;
    padding: 140px 0 32px;
  }

  .about-hero__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 40px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .about-hero__number {
    opacity: 0.55;
  }

  .about-hero__title-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 48px;
    align-items: end;
    margin-bottom: 56px;
  }

  .about-hero__title {
    margin: 0;
    font-size: clamp(72px, 12vw, 190px);
    line-height: 0.78;
    letter-spacing: -0.065em;
    font-weight: 800;
    text-transform: uppercase;
  }

  .about-hero__title span {
    display: inline-block;
    color: #ffc107;
  }

  .about-hero__intro {
    padding-bottom: 8px;
  }

  .about-hero__intro p {
    max-width: 300px;
    margin: 0;
    font-size: 15px;
    line-height: 1.35;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .about-hero__visual {
    position: relative;
    width: 100%;
    height: min(55vw, 650px);
    min-height: 400px;
    overflow: hidden;
    background: #1a1e3b;
  }

  .about-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-hero__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #1a1e3b 0%, #333554 50%, #0b0f2b 100%);
  }

  .about-hero__placeholder span {
    font-size: clamp(60px, 12vw, 180px);
    font-weight: 800;
    letter-spacing: -0.08em;
    opacity: 0.12;
  }

  .about-hero__label {
    position: absolute;
    right: 24px;
    bottom: 24px;
    display: flex;
    gap: 8px;
  }

  .about-hero__label span {
    padding: 8px 11px;
    background: #ffc107;
    color: #0b0f2b;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .about-hero__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 18px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .about-hero__arrow {
    font-size: 20px;
    line-height: 1;
  }

  @media screen and (max-width: 749px) {
    .about-hero__inner {
      width: calc(100% - 32px);
      padding-top: 110px;
    }

    .about-hero__top {
      margin-bottom: 32px;
    }

    .about-hero__title-wrap {
      display: block;
      margin-bottom: 36px;
    }

    .about-hero__title {
      font-size: clamp(64px, 20vw, 110px);
      line-height: 0.8;
    }

    .about-hero__intro {
      margin-top: 32px;
    }

    .about-hero__intro p {
      max-width: 260px;
      font-size: 13px;
    }

    .about-hero__visual {
      height: 105vw;
      min-height: 360px;
    }

    .about-hero__label {
      right: 12px;
      bottom: 12px;
      flex-wrap: wrap;
      justify-content: flex-end;
      max-width: 170px;
    }

    .about-hero__label span {
      padding: 7px 9px;
      font-size: 9px;
    }
  }
</style>

{% schema %}
{
  "name": "Page Hero",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Eyebrow",
      "default": "Page title eyebrow"
    },
    {
      "type": "text",
      "id": "number",
      "label": "Number",
      "default": "01 / 03"
    },
    {
      "type": "text",
      "id": "title_line_1",
      "label": "Title Line 1",
      "default": "Page title line 1"
    },
    {
      "type": "text",
      "id": "title_line_2",
      "label": "Title Line 2 (Highlighted)",
      "default": "Page title line 2"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro Text",
      "default": "Page intro text"
    },
    {
      "type": "text",
      "id": "hero_label_1",
      "label": "Hero Label",
      "default": "CLIMB"
    },
    {
      "type": "text",
      "id": "hero_label_2",
      "label": "Hero Label",
      "default": "CONNECT"
    },
    {
      "type": "text",
      "id": "hero_label_3",
      "label": "Hero Label",
      "default": "CREATE"
    },
    {
      "type": "text",
      "id": "scroll_indicator",
      "label": "Scroll Indicator",
      "default": "SCROLL TO EXPLORE"
    }
  ],
  "presets": [
    {
      "name": "Page Hero"
    }
  ]
}
{% endschema %}
