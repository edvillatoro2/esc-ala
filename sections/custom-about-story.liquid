<div class="about-story">
  <div class="about-story__inner">
    <div class="about-story__heading">
      {% if section.settings.eyebrow != blank %}
        <span class="about-story__eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}

      {% if section.settings.title_line_1 != blank %}
        <h2 class="about-story__title">
          {{ section.settings.title_line_1 }}
          {% if section.settings.title_line_2 != blank %}
            <span>{{ section.settings.title_line_2 }}</span>
          {% endif %}
        </h2>
      {% endif %}
    </div>

    <div class="about-story__content">
      <div class="about-story__intro">
        {% if section.settings.intro_text != blank %}
          <p>{{ section.settings.intro_text }}</p>
        {% endif %}
      </div>

      <div class="about-story__copy">
        {% if section.settings.copy_text_1 != blank %}
          <p>{{ section.settings.copy_text_1 }}</p>
        {% endif %}
        {% if section.settings.copy_text_2 != blank %}
          <p>{{ section.settings.copy_text_2 }}</p>
        {% endif %}
      </div>

      <div class="about-story__details">
        {% if section.settings.detail_1 != blank %}
          <div>
            <span>01</span>
            <strong>{{ section.settings.detail_1 }}</strong>
          </div>
        {% endif %}

        {% if section.settings.detail_2 != blank %}
          <div>
            <span>02</span>
            <strong>{{ section.settings.detail_2 }}</strong>
          </div>
        {% endif %}

        {% if section.settings.detail_3 != blank %}
          <div>
            <span>03</span>
            <strong>{{ section.settings.detail_3 }}</strong>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

<style>
  .about-story {
    position: relative;
    overflow: hidden;
    background: #754c29;
    color: #ed5825;
  }

  .about-story__inner {
    width: min(1400px, calc(100% - 48px));
    margin: 0 auto;
    padding: 140px 0;
  }

  .about-story__heading {
    margin-bottom: 90px;
  }

  .about-story__eyebrow {
    display: block;
    margin-bottom: 30px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .about-story__title {
    margin: 0;
    font-size: clamp(80px, 14vw, 210px);
    line-height: 0.76;
    letter-spacing: -0.07em;
    font-weight: 800;
    text-transform: uppercase;
  }

  .about-story__title span {
    display: inline-block;
    padding-left: 10vw;
  }

  .about-story__content {
    display: grid;
    grid-template-columns: minmax(220px, 0.8fr) minmax(300px, 1fr);
    gap: 10vw;
    margin-left: 16%;
  }

  .about-story__intro p {
    margin: 0;
    max-width: 320px;
    font-size: 18px;
    line-height: 1.2;
    font-weight: 800;
    text-transform: uppercase;
  }

  .about-story__copy {
    max-width: 560px;
  }

  .about-story__copy p {
    margin: 0 0 28px;
    font-size: 20px;
    line-height: 1.4;
  }

  .about-story__details {
    grid-column: 2;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 45px;
    border-top: 1px solid rgba(11, 15, 43, 0.3);
  }

  .about-story__details div {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 15px;
  }

  .about-story__details span {
    font-size: 10px;
    opacity: 0.55;
  }

  .about-story__details strong {
    font-size: 12px;
    letter-spacing: 0.08em;
  }

  @media screen and (max-width: 749px) {
    .about-story__inner {
      width: calc(100% - 32px);
      padding: 90px 0;
    }

    .about-story__heading {
      margin-bottom: 60px;
    }

    .about-story__eyebrow {
      margin-bottom: 22px;
    }

    .about-story__title {
      font-size: clamp(68px, 20vw, 110px);
    }

    .about-story__title span {
      padding-left: 15vw;
    }

    .about-story__content {
      display: block;
      margin-left: 0;
    }

    .about-story__intro {
      margin-bottom: 45px;
    }

    .about-story__intro p {
      font-size: 16px;
    }

    .about-story__copy p {
      font-size: 17px;
      line-height: 1.45;
    }

    .about-story__details {
      margin-top: 45px;
    }

    .about-story__details strong {
      font-size: 10px;
    }
  }
</style>

{% schema %}
{
  "name": "About Story",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "02 / OUR STORY"
    },
    {
      "type": "text",
      "id": "title_line_1",
      "label": "Title Line 1",
      "default": "OUR"
    },
    {
      "type": "text",
      "id": "title_line_2",
      "label": "Title Line 2",
      "default": "STORY"
    },
    {
      "type": "text",
      "id": "intro_text",
      "label": "Intro Text",
      "default": "ESC-ALA WAS BUILT AROUND A SIMPLE IDEA: CLIMBING SHOULD BE FOR EVERYONE."
    },
    {
      "type": "text",
      "id": "copy_text_1",
      "label": "Copy Text 1",
      "default": "A PLACE TO MOVE, CHALLENGE YOURSELF, MEET NEW PEOPLE, AND FIND YOUR OWN WAY UP THE WALL."
    },
    {
      "type": "text",
      "id": "copy_text_2",
      "label": "Copy Text 2",
      "default": "FROM YOUR FIRST CLIMB TO YOUR NEXT PROJECT, ESC-ALA IS DESIGNED TO MAKE THE EXPERIENCE FEEL APPROACHABLE, CREATIVE, AND FUN."
    },
    {
      "type": "text",
      "id": "detail_1",
      "label": "Detail 1",
      "default": "CLIMB"
    },
    {
      "type": "text",
      "id": "detail_2",
      "label": "Detail 2",
      "default": "COMMUNITY"
    },
    {
      "type": "text",
      "id": "detail_3",
      "label": "Detail 3",
      "default": "PROGRESSION"
    }
  ],
  "presets": [
    {
      "name": "About Story"
    }
  ]
}
{% endschema %}
