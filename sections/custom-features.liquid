<div class="custom-features">
  <div class="custom-features__header">
    {% if section.settings.eyebrow != blank %}
      <div class="custom-feature__eyebrow">
        {{ section.settings.eyebrow }}
      </div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="custom-features__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}
  </div>

  <div class="custom-feature__grid">
    {% for block in section.blocks %}
      <article class="custom-feature" {{ block.shopify_attributes }}>
        {% if block.settings.image %}
          <div class="custom-feature__image">
            <img
              src="{{ block.settings.image | image_url: width: 1000 }}"
              alt="{{ block.settings.image.alt | escape }}"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              loading="lazy"
            >
          </div>
        {% endif %}
        <div class="custom-feature__content">
          <div class="custom-feature__number">
            {{ block.settings.number }}
          </div>

          {% if block.settings.title != blank %}
            <h3 class="custom-feature__title">
              {{ block.settings.title }}
            </h3>
          {% endif %}

          {% if block.settings.text != blank %}
            <div class="custom-feature__text">
              {{ block.settings.text }}
            </div>
          {% endif %}

          {% if block.settings.button_text != blank %}
            <a
              href="{{ block.settings.button_link }}"
              class="custom-feature__link"
            >
              {{ block.settings.button_text }}
              <span aria-hidden="true">→</span>
            </a>
          {% endif %}
        </div>
      </article>
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .custom-features {
    background: #000000;
    color: #ffffff;
    padding: 7rem 6rem;
  }
  .custom-features__header {
    max-width: 900px;
    margin-bottom: 4rem;
  }
  .custom-features__eyebrow {
    margin-bottom: 1.5rem;
    color: #fbb040;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .custom-features__heading {
    margin: 0;
    font-size: clamp(3.5rem, 7vw, 7rem);
    line-height: 0.85;
    font-weight: 900;
    letter-spacing: -0.05em;
    text-transform: uppercase;
  }
  .custom-features__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .custom-feature {
    background: #754c29;
    color: #ffffff;
  }
  .custom-feature:nth-child(1) {
    background: #fbb040;
    color: #000000;
  }

  .custom-feature:nth-child(2) {
    background: #ed5825;
    color: #ffffff;
  }

  .custom-feature:nth-child(3) {
    background: #754c29;
    color: #ffffff;
  }
  .custom-feature__image {
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }
  .custom-feature__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .custom-feature:hover .custom-feature__image img {
    transform: scale(1.03);
  }
  .custom-feature__content {
    padding: 2rem;
  }
  .custom-feature__number {
    margin-bottom: 1rem;
    color: #fbb040;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }
  .custom-feature:nth-child(1) .custom-feature__number {
    color: #000000;
  }
  .custom-feature__title {
    margin: 0;
    font-size: clamp(2rem, 3vw, 3rem);
    line-height: 0.9;
    font-weight: 900;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }
  .custom-feature__text {
    margin-top: 1.25rem;
    font-size: 1rem;
    line-height: 1.5;
  }
  .custom-feature__link {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
    color: #ffffff;
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .custom-feature__link span {
    color: #fbb040;
    font-size: 1.2rem;
    transition: transform 0.2s ease;
  }
  .custom-feature:nth-child(1) .custom-feature__link span {
    color: #000000;
  }
  .custom-feature__link:hover span {
    transform: translateX(4px);
  }
  @media screen and (max-width: 900px) {
    .custom-features {
      padding: 5rem 2rem;
    }
    .custom-features__grid {
      grid-template-columns: 1fr;
    }
    .custom-feature__image {
      aspect-ratio: 16 / 10;
    }
  }
  @media screen and (max-width: 600px) {
    .custom-features {
      padding: 4rem 1.25rem;
    }
    .custom-features__heading {
      font-size: clamp(3rem, 14vw, 5rem);
    }
    .custom-feature__image {
      aspect-ratio: 4 / 3;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Custom Features",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "What We Do"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Climb Your Way"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "01"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Bouldering"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description",
          "default": "<p>Climb, explore, and challenge yourself on walls designed for every level.</p>"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Learn More"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Features",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "number": "01",
            "title": "BOULDERING"
          }
        },
        {
          "type": "feature",
          "settings": {
            "number": "02",
            "title": "Fitness"
          }
        },
        {
          "type": "feature",
          "settings": {
            "number": "03",
            "title": "Community"
          }
        }
      ]
    }
  ]
}
{% endschema %}
