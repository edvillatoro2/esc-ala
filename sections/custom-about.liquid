<div class="custom-about">
  <div class="custom-about__content">
    <div class="custom-about__copy">
      {% if section.settings.eyebrow != blank %}
        <div class="custom-about__eyebrow">
          {{ section.settings.eyebrow }}
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="custom-about__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="custom-about__text">
          {{ section.settings.text }}
        </div>
      {% endif %}

      {% if section.settings.button_text != blank %}
        <a
          href="{{ section.settings.button_link }}"
          class="custom-about__button"
        >
          {{ section.settings.button_text }}
          <span aria-hidden="true">→</span>
        </a>
      {% endif %}
    </div>

    {% if section.settings.image %}
      <div class="custom-about__image">
        <img
          src="{{ section.settings.image | image_url: width: 1200 }}"
          alt="{{ section.settings.image.alt | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="lazy"
        >
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .custom-about {
    background: #754c29;
    color: #ffffff;
    padding: 0;
  }
  .custom-about__content {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
  }
  .custom-about__copy {
    max-width: 600px;
    padding: 7rem 0 7rem 6rem;
    align-self: center;
  }
  .custom-about__eyebrow {
    margin-bottom: 1.5rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fbb040;
  }
  .custom-about__heading {
    margin: 0;
    font-size: clamp(3.5rem, 6vw, 6.5rem);
    line-height: 0.86;
    font-weight: 900;
    letter-spacing: -0.045em;
    text-transform: uppercase;
  }
  .custom-about__text {
    max-width: 500px;
    margin-top: 2rem;
    font-size: 1.1rem;
    line-height: 1.6;
  }
  .custom-about__button {
    display: inline-flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 2.5rem;
    padding: 1rem 1.5rem;
    background: #fbb040;
    color: #000000;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }
  .custom-about__button:hover {
    background: #ed5825;
    color: #ffffff;
    transform: translateY(-2px);
  }
  .custom-about__image {
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  .custom-about__image img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 100%;
    object-fit: cover;
  }
  @media screen and (max-width: 750px) {
    .custom-about {
      padding: 4rem 1.25rem;
    }
    .custom-about__copy {
      padding: 0;
    }
    .custom-about__content {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .custom-about__heading {
      font-size: clamp(3rem, 14vw, 5rem);
    }
    .custom-about__image img {
      height: 450px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Custom About",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "MORE THAN A GYM"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A COMMUNITY"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>ESC-ALA is a place to move, connect, and grow. Whether you're stepping onto the wall for the first time or working toward your next project, there's a place for you here.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "OUR STORY"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "presets": [
    {
      "name": "Custom About"
    }
  ]
}
{% endschema %}
