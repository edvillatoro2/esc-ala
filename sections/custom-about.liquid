<div class="custom-about">
  <div class="custom-about__content">
    <div class="custom-about__copy">
      {% if section.settings.eyebrow != blank %}
        <div class="custom-about__eyebrow">
          {{ section.settings.eyebrow }}
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="custom-about__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="custom-about__text">
          {{ section.settings.text }}
        </div>
      {% endif %}

      {% if section.settings.button_text != blank %}
        <a
          href="{{ section.settings.button_link }}"
          class="custom-about__button"
        >
          {{ section.settings.button_text }}
          <span aria-hidden="true">→</span>
        </a>
      {% endif %}
    </div>

    {% if section.settings.image %}
      <div class="custom-about__image">
        <img
          class="custom-about__wall"
          src="{{ section.settings.image | image_url: width: 1200 }}"
          alt="{{ section.settings.image.alt | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="lazy"
        >
        {% for i in (1..6) %}
          {% assign hold_key = 'hold_' | append: i %}
          {% assign hold = section.settings[hold_key] %}
          {% if hold %}
            <img
              class="custom-about__hold custom-about__hold--{{ i }}"
              src="{{ hold | image_url: width: 400 }}"
              alt=""
              width="{{ hold.width }}"
              height="{{ hold.height }}"
              loading="lazy"
            >
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .custom-about {
    background: #754c29;
    color: #ffffff;
    padding: 0;
  }
  .custom-about__content {
    width: 100%;
    display: flex;
    flex-direction: row-reverse;
  }
  .custom-about__copy {
    max-width: 50%;
    padding: 5rem 4rem;
  }
  .custom-about__eyebrow {
    margin-bottom: 1.5rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fbb040;
  }
  .custom-about__heading {
    margin: 0;
    font-size: clamp(2.5rem, 5vw, 6.5rem);
    line-height: 0.86;
    font-weight: 900;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    display: inline-block;
  }
  .custom-about__text {
    max-width: 500px;
    margin-top: 2rem;
    font-size: 1.1rem;
    line-height: 1.6;
  }
  .custom-about__button {
    display: inline-flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 2.5rem;
    padding: 1rem 1.5rem;
    background: #fbb040;
    color: #000000;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: background-color 0.275s ease, transform 0.275s ease;
  }
  .custom-about__button:hover {
    background: #ed5825;
    color: #ffffff;
    transform: translateY(-4px);
  }
  .custom-about__image {
    position: relative;
    overflow: hidden;
  }
  .custom-about__wall {
    height: 100%;
    width: auto;
    position: relative;
    z-index: 1;
  }
  .custom-about__hold {
    position: absolute;
    z-index: 2;
    width: clamp(55px, 9vw, 100px);
    height: auto;
    pointer-events: none;
    transform-origin: center center;
    will-change: transform;
  }
  .custom-about__hold--1 {
    left: 10%;
    top: 65%;
  }
  .custom-about__hold--2 {
    left: 29%;
    top: 27%;
  }
  .custom-about__hold--3 {
    left: 42%;
    top: 22%;
  }
  .custom-about__hold--4 {
    left: 66%;
    top: 2%;
  }
  .custom-about__hold--5 {
    left: 65%;
    top: 22%;
  }
  .custom-about__hold--6 {
    left: 21%;
    top: 45%;
  }
  @media screen and (max-width: 750px) {
    .custom-about {
      padding: 4rem 1.25rem;
    }
    .custom-about__copy {
      padding: 0;
    }
    .custom-about__content {
      display: flex;
      flex-direction: column;
      gap: 3rem;
    }
    .custom-about__heading {
      font-size: clamp(3rem, 10vw, 5rem);
    }
    .custom-about__hold {
      width: clamp(45px, 14vw, 85px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Custom About",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "MORE THAN A GYM"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A COMMUNITY"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>ESC-ALA is a place to move, connect, and grow. Whether you're stepping onto the wall for the first time or working toward your next project, there's a place for you here.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "OUR STORY"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "hold_1",
      "label": "Climbing Hold 1"
    },
    {
      "type": "image_picker",
      "id": "hold_2",
      "label": "Climbing Hold 2"
    },
    {
      "type": "image_picker",
      "id": "hold_3",
      "label": "Climbing Hold 3"
    },
    {
      "type": "image_picker",
      "id": "hold_4",
      "label": "Climbing Hold 4"
    },
    {
      "type": "image_picker",
      "id": "hold_5",
      "label": "Climbing Hold 5"
    },
    {
      "type": "image_picker",
      "id": "hold_6",
      "label": "Climbing Hold 6"
    }
  ],
  "presets": [
    {
      "name": "Custom About"
    }
  ]
}
{% endschema %}
