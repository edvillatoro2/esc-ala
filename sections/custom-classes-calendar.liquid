  #ClassSchedule-{{ section.id }} .class-schedule-page__card-level,
  #ClassSchedule-{{ section.id }} .class-schedule-page__card-more {
    color: var(--schedule-yellow);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #ClassSchedule-{{ section.id }} .class-schedule-page__class-card strong {
    font-size: 13px;
    font-weight: 800;
    line-height: 1.25;
  }

  #ClassSchedule-{{ section.id }} .class-schedule-page__card-time {
    color: #d1d1d1;
    font-size: 10px;
    line-height: 1.4;
  }

  #ClassSchedule-{{ section.id }} .class-schedule-page__card-more {
    margin-top: auto;
    color: #c6c6c6;
    font-size: 8px;
  }

  #ClassSchedule-{{ section.id }} .class-schedule-page__scroll-note {
    margin: 14px 0 0;
    color: var(--schedule-muted);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-align: right;
    text-transform: uppercase;
  }

  #ClassSchedule-{{ section.id }} .class-schedule-page__cta {
    display: flex;
    justify-content: space-between;
    align-items: center;
