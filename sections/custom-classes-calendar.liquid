<div class="class-schedule-page" id="ClassSchedule-{{ section.id }}">
  <!-- HERO -->
  <div class="class-schedule-page__hero">
    <div class="class-schedule-page__hero-copy">
      <p class="class-schedule-page__eyebrow">
        {{ section.settings.eyebrow | escape }}
      </p>

      <h1 class="class-schedule-page__title">
        {{ section.settings.title_line_1 | escape }}
        <span>{{ section.settings.title_highlight | escape }}</span>
      </h1>

      <p class="class-schedule-page__intro">
        {{ section.settings.intro | escape }}
      </p>

      <div class="class-schedule-page__hero-meta">
        <span>{{ section.settings.meta_label | escape }}</span>
        <span class="class-schedule-page__hero-line"></span>
        <span>{{ section.settings.meta_value | escape }}</span>
      </div>
    </div>

    {% if section.settings.hero_image != blank %}
      <div class="class-schedule-page__hero-image">
        {{ section.settings.hero_image | image_url: width: 1200 | image_tag: loading: 'eager' }}
      </div>
    {% endif %}
  </div>

  <!-- WEEKLY CALENDAR -->
  <div class="class-schedule-page__calendar-wrap">
    <div class="class-schedule-page__section-head">
      <div>
        <p class="class-schedule-page__eyebrow">
          {{ section.settings.calendar_eyebrow | escape }}
        </p>
        <h2>{{ section.settings.calendar_title | escape }}</h2>
      </div>

      <div class="class-schedule-page__week-controls">
        <button type="button" data-week-prev>← PREVIOUS WEEK</button>
        <p data-date-range aria-live="polite"></p>
        <button type="button" data-week-next>NEXT WEEK →</button>
      </div>
    </div>

    <div class="class-schedule-page__calendar-scroll">
      <div class="class-schedule-page__calendar">
        <div class="class-schedule-page__time-heading">TIME</div>

        {% assign days = 'Monday,Tuesday,Wednesday,Thursday,Friday,Saturday,Sunday' | split: ',' %}

        {% for day in days %}
          <div class="class-schedule-page__day-heading">
            <span>{{ day | slice: 0, 3 | upcase }}</span>
            <strong data-day-date="{{ forloop.index0 }}">--</strong>
          </div>
        {% endfor %}

        {% assign times = '9:00 AM,10:00 AM,11:00 AM,12:30 PM,2:00 PM,4:00 PM,5:30 PM,6:00 PM' | split: ',' %}

        {% for time in times %}
          <div class="class-schedule-page__time-cell">
            {{ time }}
          </div>

          {% for day in days %}
            {% assign current_day_index = forloop.index0 %}

            <div class="class-schedule-page__slot">
              {% for block in section.blocks %}
                {% assign block_day_index = block.settings.day | plus: 0 %}

                {% if block_day_index == current_day_index and block.settings.time == time %}
                  <button
                    type="button"
                    class="class-schedule-page__class-card class-schedule-page__class-card--{{ block.settings.level }}"
                    data-class-card
                    data-title="{{ block.settings.title | escape }}"
                    data-day="{{ day | escape }}"
                    data-time="{{ block.settings.time | escape }}"
                    data-level="{{ block.settings.level_label | escape }}"
                    data-duration="{{ block.settings.duration | escape }}"
                    data-description="{{ block.settings.description | escape }}"
                    data-instructor="{{ block.settings.instructor | escape }}"
                    {{ block.shopify_attributes }}
                  >
                    <span class="class-schedule-page__card-level">
                      {{ block.settings.level_label | escape }}
                    </span>

                    <strong>{{ block.settings.title | escape }}</strong>

                    <span class="class-schedule-page__card-time">
                      {{ block.settings.time | escape }}
                      · {{ block.settings.duration | escape }}
                    </span>

                    <span class="class-schedule-page__card-more"> VIEW DETAILS ↗ </span>
                  </button>
                {% endif %}
              {% endfor %}
            </div>
          {% endfor %}
        {% endfor %}
      </div>
    </div>

    <p class="class-schedule-page__scroll-note">ON MOBILE, SWIPE TO EXPLORE THE FULL WEEK →</p>
  </div>

  <!-- CONTACT CTA -->
  <div class="class-schedule-page__cta">
    <div>
      <p class="class-schedule-page__eyebrow">
        {{ section.settings.cta_eyebrow | escape }}
      </p>

      <h2>{{ section.settings.cta_title | escape }}</h2>

      <p>{{ section.settings.cta_text | escape }}</p>
    </div>

    <a
      class="class-schedule-page__cta-button"
      href="{{ section.settings.button_link | default: '/pages/contact' }}"
    >
      {{ section.settings.button_label | escape }} ↗
    </a>
  </div>

  <!-- CLASS DETAILS -->
  <dialog class="class-schedule-page__dialog" data-class-dialog>
    <button type="button" data-dialog-close aria-label="Close">×</button>

    <p class="class-schedule-page__eyebrow" data-dialog-level></p>
    <h2 data-dialog-title></h2>
    <p data-dialog-meta></p>
    <div data-dialog-description></div>
    <p data-dialog-instructor></p>

    <a
      class="class-schedule-page__cta-button"
      href="{{ section.settings.button_link | default: '/pages/contact' }}"
    >
      ASK ABOUT THIS CLASS ↗
    </a>
  </dialog>
</div>

<style>
  #ClassSchedule-{{ section.id }} {
    --schedule-yellow: #FBB040;
    --schedule-orange: #ED5825;
    --schedule-brown: #754C29;
    --schedule-black: #000000;
    --schedule-white: #FFFFFF;
    --schedule-muted: #a5a5a5;
    background: var(--schedule-black);
    color: var(--schedule-white);
    overflow: hidden;
  }

  #ClassSchedule-{{ section.id }} * {
    box-sizing: border-box;
  }

  #ClassSchedule-{{ section.id }} .class-schedule-page__hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    min-height: 520px;
    border-bottom: 1px solid #333;
  }

  #ClassSchedule-{{ section.id }} .class-schedule-page__hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: clamp(36px, 7vw, 100px);
  }

  #ClassSchedule-{{ section.id }} .class-schedule-page__eyebrow {
    margin: 0 0 22px;
    color: var(--schedule-yellow);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  #ClassSchedule-{{ section.id }} .class-schedule-page__title {
    max-width: 720px;
    margin: 0;
    font-size: clamp(48px, 7vw, 100px);
    font-weight: 900;
    letter-spacing: -0.065em;
    line-height: 0.92;
    text-transform: uppercase;
  }

  #ClassSchedule-{{ section.id }} .class-schedule-page__title span {
    display: block;
    color: var(--schedule-yellow);
  }

  #ClassSchedule-{{ section.id }} .class-schedule-page__intro {
    max-width: 470px;
