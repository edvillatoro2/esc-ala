    background: var(--schedule-yellow);
    color: var(--schedule-black);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background 180ms ease, color 180ms ease;
  }

  #ClassSchedule-{{ section.id }} .class-schedule-page__cta-button:hover {
    background: transparent;
    color: var(--schedule-yellow);
  }

  #ClassSchedule-{{ section.id }} .class-schedule-page__dialog {
    position: fixed;
    width: min(560px, calc(100% - 32px));
    max-width: 560px;
    max-height: calc(100% - 32px);
    padding: clamp(28px, 5vw, 48px);
    border: 1px solid var(--schedule-brown);
    border-top: 4px solid var(--schedule-yellow);
    background: #111;
    color: var(--schedule-white);
    overflow-y: auto;
  }

  #ClassSchedule-{{ section.id }} .class-schedule-page__dialog::backdrop {
    background: rgb(0 0 0 / 78%);
    backdrop-filter: blur(4px);
  }

  #ClassSchedule-{{ section.id }} .class-schedule-page__dialog [data-dialog-close] {
    position: absolute;
    top: 12px;
    right: 16px;
    border: 0;
    background: transparent;
    color: var(--schedule-white);
    font-size: 32px;
    cursor: pointer;
