  #ClassSchedule-{{ section.id }} .class-schedule-page__dialog h2 {
    margin: 0 0 14px;
    padding-right: 20px;
    font-size: clamp(28px, 5vw, 42px);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1;
    text-transform: uppercase;
  }

  #ClassSchedule-{{ section.id }} .class-schedule-page__dialog [data-dialog-meta],
  #ClassSchedule-{{ section.id }} .class-schedule-page__dialog [data-dialog-instructor] {
    color: var(--schedule-yellow);
    font-size: 12px;
    line-height: 1.6;
  }

  #ClassSchedule-{{ section.id }} .class-schedule-page__dialog [data-dialog-description] {
    margin: 24px 0;
    color: #d0d0d0;
    line-height: 1.8;
  }

  #ClassSchedule-{{ section.id }} .class-schedule-page__dialog .class-schedule-page__cta-button {
    margin-top: 12px;
  }

  #ClassSchedule-{{ section.id }} :is(button, a):focus-visible {
    outline: 2px solid var(--schedule-yellow);
    outline-offset: 4px;
  }

  @media (max-width: 900px) {
    #ClassSchedule-{{ section.id }} .class-schedule-page__hero {
      grid-template-columns: 1fr;
    }

    #ClassSchedule-{{ section.id }} .class-schedule-page__hero-copy {
      padding: 60px 28px;
    }

    #ClassSchedule-{{ section.id }} .class-schedule-page__hero-image,
    #ClassSchedule-{{ section.id }} .class-schedule-page__hero-image img {
      min-height: 360px;
      max-height: 520px;
    }

    #ClassSchedule-{{ section.id }} .class-schedule-page__section-head {
      align-items: flex-start;
      flex-direction: column;
    }

    #ClassSchedule-{{ section.id }} .class-schedule-page__week-controls {
      justify-content: flex-start;
    }

    #ClassSchedule-{{ section.id }} .class-schedule-page__cta {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 520px) {
    #ClassSchedule-{{ section.id }} .class-schedule-page__hero-copy {
      padding: 48px 22px;
    }

    #ClassSchedule-{{ section.id }} .class-schedule-page__title {
      font-size: clamp(46px, 14vw, 70px);
    }

    #ClassSchedule-{{ section.id }} .class-schedule-page__intro {
      font-size: 14px;
    }

    #ClassSchedule-{{ section.id }} .class-schedule-page__calendar-wrap {
      padding: 48px 16px;
    }

    #ClassSchedule-{{ section.id }} .class-schedule-page__week-controls {
      display: grid;
      grid-template-columns: 1fr 1fr;
      width: 100%;
    }

    #ClassSchedule-{{ section.id }} [data-date-range] {
      grid-column: 1 / -1;
      grid-row: 1;
      text-align: left;
    }

    #ClassSchedule-{{ section.id }} .class-schedule-page__week-controls button {
      padding: 12px 8px;
      font-size: 9px;
    }

    #ClassSchedule-{{ section.id }} .class-schedule-page__cta {
      padding: 48px 22px;
    }

    #ClassSchedule-{{ section.id }} .class-schedule-page__cta-button {
      width: 100%;
    }

    #ClassSchedule-{{ section.id }} .class-schedule-page__scroll-note {
      font-size: 8px;
      text-align: left;
    }
