  @media (prefers-reduced-motion: reduce) {
    #ClassSchedule-{{ section.id }} *,
    #ClassSchedule-{{ section.id }} *::before,
    #ClassSchedule-{{ section.id }} *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
    }
  }
</style>

<script>
  (() => {
    const root = document.getElementById('ClassSchedule-{{ section.id }}');
    if (!root || root.dataset.scheduleInitialized === 'true') return;

    root.dataset.scheduleInitialized = 'true';

    const previousButton = root.querySelector('[data-week-prev]');
    const nextButton = root.querySelector('[data-week-next]');
    const rangeLabel = root.querySelector('[data-date-range]');
    const dayDates = root.querySelectorAll('[data-day-date]');
    const dialog = root.querySelector('[data-class-dialog]');
    const closeButton = root.querySelector('[data-dialog-close]');

    if (!previousButton || !nextButton || !rangeLabel || !dialog) return;

    // Start with the current week, Monday through Sunday.
    const today = new Date();
    today.setHours(12, 0, 0, 0);

    const monday = new Date(today);
    const dayOfWeek = (today.getDay() + 6) % 7;
    monday.setDate(today.getDate() - dayOfWeek);

    let weekOffset = 0;

    const formatDate = (date, options) => new Intl.DateTimeFormat('en-US', options).format(date);

    const getWeekStart = () => {
      const start = new Date(monday);
      start.setDate(monday.getDate() + weekOffset * 7);
      return start;
    };

    const updateCalendarDates = () => {
      const start = getWeekStart();
      const end = new Date(start);
      end.setDate(start.getDate() + 6);

      rangeLabel.textContent =
        `${formatDate(start, { month: 'short', day: 'numeric' })} – ` +
        `${formatDate(end, { month: 'short', day: 'numeric', year: 'numeric' })}`;

      dayDates.forEach((element) => {
        const index = Number(element.dataset.dayDate);
        const date = new Date(start);
        date.setDate(start.getDate() + index);

        element.textContent = date.getDate();

        const isToday = date.toDateString() === today.toDateString();
        element.closest('.class-schedule-page__day-heading')?.classList.toggle('is-today', isToday);

        element.setAttribute(
          'aria-label',
          formatDate(date, {
            weekday: 'long',
            month: 'long',
            day: 'numeric',
          })
        );
      });
    };

    previousButton.addEventListener('click', () => {
      weekOffset -= 1;
      updateCalendarDates();
    });

    nextButton.addEventListener('click', () => {
      weekOffset += 1;
      updateCalendarDates();
    });

    root.querySelectorAll('[data-class-card]').forEach((card) => {
      card.addEventListener('click', () => {
        root.querySelector('[data-dialog-level]').textContent = card.dataset.level || '';

        root.querySelector('[data-dialog-title]').textContent = card.dataset.title || 'Class details';

        root.querySelector('[data-dialog-meta]').textContent =
          `${card.dataset.day || ''} · ${card.dataset.time || ''}` +
          (card.dataset.duration ? ` · ${card.dataset.duration}` : '');

        root.querySelector('[data-dialog-description]').textContent =
          card.dataset.description || 'Contact us to learn more about this class.';

        const instructor = root.querySelector('[data-dialog-instructor]');
        instructor.textContent = card.dataset.instructor ? `INSTRUCTOR: ${card.dataset.instructor}` : '';

        if (typeof dialog.showModal === 'function') {
          dialog.showModal();
        }
      });
    });

    closeButton?.addEventListener('click', () => dialog.close());

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    updateCalendarDates();
  })();
</script>

{% schema %}
{
  "name": "Classes calendar",
  "settings": [
    {
      "type": "header",
      "content": "Page hero"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FIND YOUR NEXT CHALLENGE"
    },
    {
      "type": "text",
      "id": "title_line_1",
      "label": "Title — first line",
      "default": "THE CLASS"
    },
    {
      "type": "text",
      "id": "title_highlight",
      "label": "Title — highlighted line",
      "default": "SCHEDULE."
    },
    {
