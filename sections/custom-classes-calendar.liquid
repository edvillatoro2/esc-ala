    font-weight: 700;
    letter-spacing: 0.08em;
  }

  #ClassSchedule-{{ section.id }} .class-schedule-page__day-heading span {
    color: var(--schedule-muted);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  #ClassSchedule-{{ section.id }} .class-schedule-page__day-heading strong {
    font-size: 22px;
    font-weight: 800;
    line-height: 1;
