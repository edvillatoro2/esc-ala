<div class="membership-hero">
  <div class="membership-hero__inner">
    <div class="membership-hero__top">
      {% if section.settings.eyebrow != blank %}
        <span class="membership-hero__eyebrow">
          {{ section.settings.eyebrow }}
        </span>
      {% endif %}
      {% if section.settings.number != blank %}
        <span class="membership-hero__number">
          {{ section.settings.number }}
        </span>
      {% endif %}
    </div>
    <div class="membership-hero__heading">
      {% if section.settings.title_line_1 != blank %}
        <h1 class="membership-hero__title">
          {{ section.settings.title_line_1 -}}
          <br>
          {% if section.settings.title_line_2 != blank %}
            <span>{{ section.settings.title_line_2 }}</span>
          {% endif %}
        </h1>
      {% endif %}
      {% if section.settings.intro != blank %}
        <p class="membership-hero__intro">
          {{ section.settings.intro }}
        </p>
      {% endif %}
    </div>
    <div class="membership-hero__visual">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 2000
          | image_tag: loading: 'eager', widths: '600, 900, 1200, 1600, 2000', class: 'membership-hero__image'
        }}
      {% else %}
        <div class="membership-hero__placeholder">
          <span>ESC_ALA</span>
        </div>
      {% endif %}
      <div class="membership-hero__overlay">
        {% if section.settings.image_label_1 != blank %}
          <span>{{ section.settings.image_label_1 }}</span>
        {% endif %}
        {% if section.settings.image_label_2 != blank %}
          <span>{{ section.settings.image_label_2 }}</span>
        {% endif %}
        {% if section.settings.image_label_3 != blank %}
          <span>{{ section.settings.image_label_3 }}</span>
        {% endif %}
      </div>
    </div>
    <div class="membership-hero__bottom">
      {% if section.settings.bottom_text != blank %}
        <span>{{ section.settings.bottom_text }}</span>
      {% endif %}
      {% if section.settings.bottom_right != blank %}
        <span>{{ section.settings.bottom_right }}</span>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .membership-hero {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: #0b0f2b;
    color: #ffffff;
  }
  .membership-hero__inner {
    width: min(1400px, calc(100% - 48px));
    margin: 0 auto;
    padding: 140px 0 32px;
  }
  .membership-hero__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 40px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }
  .membership-hero__number {
    opacity: 0.55;
  }
  .membership-hero__heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 48px;
    align-items: end;
    margin-bottom: 56px;
  }
  .membership-hero__title {
    margin: 0;
    font-size: clamp(72px, 12vw, 190px);
    line-height: 0.78;
    letter-spacing: -0.065em;
    font-weight: 800;
    text-transform: uppercase;
  }
  .membership-hero__title span {
    display: inline-block;
    color: #ffc107;
  }
  .membership-hero__intro {
    max-width: 300px;
    margin: 0 0 8px;
    font-size: 15px;
    line-height: 1.35;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .membership-hero__visual {
    position: relative;
    width: 100%;
    height: min(55vw, 650px);
    min-height: 400px;
    overflow: hidden;
    background: #1a1e3b;
  }
  .membership-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .membership-hero__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #1a1e3b 0%, #333554 50%, #0b0f2b 100%);
  }
  .membership-hero__placeholder span {
    font-size: clamp(60px, 12vw, 180px);
    font-weight: 800;
    letter-spacing: -0.08em;
    opacity: 0.12;
  }
  .membership-hero__overlay {
    position: absolute;
    right: 24px;
    bottom: 24px;
    display: flex;
    gap: 8px;
  }
  .membership-hero__overlay span {
    padding: 8px 11px;
    background: #ffc107;
    color: #0b0f2b;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
  }
  .membership-hero__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 18px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }
  @media screen and (max-width: 749px) {
    .membership-hero__inner {
      width: calc(100% - 32px);
      padding-top: 110px;
    }
    .membership-hero__top {
      margin-bottom: 32px;
    }
    .membership-hero__heading {
      display: block;
      margin-bottom: 36px;
    }
    .membership-hero__title {
      font-size: clamp(64px, 20vw, 110px);
      line-height: 0.8;
    }
    .membership-hero__intro {
      max-width: 260px;
      margin-top: 32px;
      font-size: 13px;
    }
    .membership-hero__visual {
      height: 105vw;
      min-height: 360px;
    }
    .membership-hero__overlay {
      right: 12px;
      bottom: 12px;
      flex-wrap: wrap;
      justify-content: flex-end;
      max-width: 190px;
    }
    .membership-hero__overlay span {
      padding: 7px 9px;
      font-size: 9px;
    }
  }
</style>

{% schema %}
{
  "name": "Membership Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "MEMBERSHIP"
    },
    {
      "type": "text",
      "id": "number",
      "label": "Number",
      "default": "01 / 04"
    },
    {
      "type": "text",
      "id": "title_line_1",
      "label": "Title Line 1",
      "default": "CLIMB"
    },
    {
      "type": "text",
      "id": "title_line_2",
      "label": "Title Line 2 (Highlighted)",
      "default": "MORE."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro Text",
      "default": "ONE MEMBERSHIP. UNLIMITED CLIMBING. A COMMUNITY TO KEEP YOU COMING BACK."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id": "image_label_1",
      "label": "Image Label 1",
      "default": "CLIMB"
    },
    {
      "type": "text",
      "id": "image_label_2",
      "label": "Image Label 2",
      "default": "CONNECT"
    },
    {
      "type": "text",
      "id": "image_label_3",
      "label": "Image Label 3",
      "default": "PROGRESS"
    },
    {
      "type": "text",
      "id": "bottom_text",
      "label": "Bottom Left",
      "default": "FIND YOUR MEMBERSHIP"
    },
    {
      "type": "text",
      "id": "bottom_right",
      "label": "Bottom Right",
      "default": "ESC_ALA®"
    }
  ],
  "presets": [
    {
      "name": "Membership Hero"
    }
  ]
}
{% endschema %}
